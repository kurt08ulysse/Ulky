# Environnement CI uniquement — NE JAMAIS utiliser en production.
# Copié vers .env par le workflow GitHub Actions (cp .env.ci .env).
# Aucune valeur réelle : tout est mocké (Clerk HS256, SingPay status forcé).

APP_NAME=ULKY
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Base de données — SQLite fichier (partagé entre les étapes migrate/seed du CI).
# Le fichier est créé automatiquement par PDO lors du premier migrate.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=array
MAIL_MAILER=array

# Clerk — mode test symétrique HS256 : aucun appel réseau, aucune dépendance OpenSSL.
# Honoré uniquement hors production (cf. ClerkAuthenticate::resolveKeys).
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_WEBHOOK_SECRET=
CLERK_AUTHORIZED_PARTY=
CLERK_TESTING_SECRET=super-secret-test-key-ulky-2026-abcdefgh

# SingPay — valeurs vides obligatoires (SingPayService type ses propriétés) ;
# SINGPAY_TESTING_STATUS pilote la réponse mockée de checkTransactionStatus().
SINGPAY_WALLET_ID=
SINGPAY_CLIENT_ID=
SINGPAY_CLIENT_SECRET=
SINGPAY_BASE_URL=https://gateway.singpay.ga/v1
SINGPAY_WEBHOOK_SECRET=ci-singpay-webhook-secret
SINGPAY_TESTING_STATUS=successful
